# ==============================================================================
# Git Ignore - Enterprise Storage Service Lifecycle & Disaster Recovery Lab
# ==============================================================================

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Terraform Files & State
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible Artifacts & Secrets
ansible/inventory/hosts.ini
ansible/inventory/group_vars/all.yml
*.retry
*.log
.ansible/

# SSH Keys & Credentials
*.pem
*.key
*.pub
*.rsa
id_rsa*
id_ed25519*
secrets/

# Backup & Staging Dumps
*.tar.gz
*.tgz
*.sha256
/tmp/
/staging/
/mnt/snapshot_temp/

# Python & System Logs
__pycache__/
*.pyc
*.log
