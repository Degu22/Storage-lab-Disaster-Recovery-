global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "/etc/prometheus/rules/storage_alerts.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - '127.0.0.1:9093' # Local Alertmanager daemon

scrape_configs:
  - job_name: 'prometheus_self'
    static_configs:
      - targets: ['127.0.0.1:9090']

  - job_name: 'storage_nodes'
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - "{{ hostvars[host]['private_ip'] | default(hostvars[host]['ansible_host']) }}:9100"
{% endfor %}
        labels:
          environment: 'storage_lab'
          tier: 'enterprise_storage'
