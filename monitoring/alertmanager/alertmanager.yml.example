# ==============================================================================
# Alertmanager Configuration
# ==============================================================================
# IMPORTANT: By default, this configuration routes alerts to a null/blackhole receiver
# to avoid failing alert dispatch attempts when no external notification channels
# (Slack, PagerDuty, or SMTP) are configured in the lab.
# Configure an active receiver below when integration credentials are provided.
# ==============================================================================

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'tier']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  # Default to local-logger/blackhole receiver in lab environment
  receiver: 'local-audit-logger'

receivers:
  # Default receiver: routes alerts to local null endpoint during lab testing
  - name: 'local-audit-logger'

  # Example integration for enterprise webhook (e.g. custom incident response bridge)
  # - name: 'storage-team-webhook'
  #   webhook_configs:
  #     - url: 'http://127.0.0.1:5001/webhook'
  #       send_resolved: true

  # Example integration for Slack notifications
  # - name: 'storage-team-slack'
  #   slack_configs:
  #     - channel: '#storage-alerts'
  #       api_url: 'https://hooks.slack.com/services/REPLACE_WITH_ACTUAL_WEBHOOK_URL'
